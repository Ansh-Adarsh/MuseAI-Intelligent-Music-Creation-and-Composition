# MuseAI frontend configuration (copy to .env.local and adjust)

# "mock" = in-browser mock services (no backend needed)
# "http" = call the FastAPI backend at VITE_API_BASE_URL
VITE_SERVICE_MODE=mock

# Base URL of the future FastAPI backend that wraps ACE-Step 1.5
VITE_API_BASE_URL=http://localhost:8000

# Polling interval (ms) for GET /api/music/status/{task_id}
VITE_POLL_INTERVAL_MS=1500

# Client-side upload limit in MB
VITE_MAX_UPLOAD_MB=50
